{
  "permissions": {
    "allow": [
      "Bash"
    ],
    "ask": [
      "Bash(firebase deploy:*)",
      "Bash(firebase firestore:delete:*)",
      "Bash(pnpm deploy:*)",
      "Bash(pnpm run deploy:*)"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git checkout --:*)",
      "Bash(git branch -D:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git filter-branch:*)",
      "Bash(sudo:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",
      "Bash(mv:*)",
      "Bash(dd:*)",
      "Bash(truncate:*)",
      "Bash(npm publish:*)",
      "Bash(pnpm publish:*)",
      "Bash(firebase projects:delete:*)",
      "Bash(firebase firestore:databases:delete:*)",
      "Bash(firebase apps:delete:*)"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/confirm-git-push.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/confirm-firebase-deploy.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
