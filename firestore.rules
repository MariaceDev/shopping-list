rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(listId) {
      return signedIn()
        && exists(/databases/$(database)/documents/lists/$(listId)/members/$(request.auth.uid));
    }

    match /lists/{listId} {
      // Cualquiera con sesión (anónima incluida) puede leer la lista y
      // unirse a ella: así funciona entrar por el tag NFC.
      allow get, create: if signedIn();
      allow update: if isMember(listId);
      allow delete: if false;

      match /members/{uid} {
        allow read: if signedIn();
        // Cada quien solo escribe su propia ficha de miembro.
        allow write: if signedIn() && request.auth.uid == uid;
      }

      match /items/{itemId} {
        allow read, create, update, delete: if isMember(listId);
      }

      match /history/{entryId} {
        allow read, create: if isMember(listId);
        allow update, delete: if false;
      }

      // Compras terminadas: lo que enseña la pantalla de Historial.
      // No se borran nunca; lo único que se puede cambiar es lo que costó
      // (`total`), que se apunta desde el Historial: un número de euros o null.
      match /trips/{tripId} {
        allow read, create: if isMember(listId);
        allow update: if isMember(listId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['total'])
          && (request.resource.data.total == null
            || (request.resource.data.total is number
              && request.resource.data.total > 0
              && request.resource.data.total <= 100000));
        allow delete: if false;
      }
    }
  }
}
