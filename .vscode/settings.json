{
  // ESLint arregla lo que puede al guardar. Las reglas salen de
  // eslint.config.mjs, que a su vez hereda las de Nuxt.
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "eslint.useFlatConfig": true,

  // Usa el TypeScript del proyecto (5.9), no el que trae VS Code.
  "typescript.tsdk": "node_modules/typescript/lib",

  // Vue 3: el soporte de .vue lo da Volar.
  "[vue]": {
    "editor.defaultFormatter": "Vue.volar"
  },

  "files.exclude": {
    "**/.nuxt": true,
    "**/.output": true
  }
}
