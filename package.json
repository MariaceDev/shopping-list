{
  "name": "shopping-list",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.21.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "emulators": "firebase emulators:start",
    "deploy": "pnpm generate && firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes"
  },
  "dependencies": {
    "firebase": "^13.2.0",
    "nuxt": "^4.6.4",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.4",
    "@vue/test-utils": "^2.5.1",
    "cssnano": "^9.9.0",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@firebase/util",
      "esbuild",
      "protobufjs"
    ]
  }
}
