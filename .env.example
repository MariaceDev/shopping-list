# La config web de Firebase ya viene por defecto en nuxt.config.ts (es pública,
# no es un secreto). Estas variables solo hacen falta para apuntar a OTRO
# proyecto de Firebase o a los emuladores.

# NUXT_PUBLIC_FIREBASE_API_KEY=
# NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NUXT_PUBLIC_FIREBASE_PROJECT_ID=
# NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NUXT_PUBLIC_FIREBASE_APP_ID=

# Pon a "true" para usar los emuladores locales (pnpm emulators)
# NUXT_PUBLIC_USE_EMULATORS=true
